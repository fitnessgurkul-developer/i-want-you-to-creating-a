# Large media is NOT stored in Git LFS (budget exceeded breaks Render/Netlify clones).
# Keep binaries as normal git objects only when small; heavy folders are gitignored.

# Explicitly disable LFS filters for common media (overrides older LFS history patterns)
*.png !filter !diff !merge -text
*.jpg !filter !diff !merge -text
*.jpeg !filter !diff !merge -text
*.JPG !filter !diff !merge -text
*.JPEG !filter !diff !merge -text
*.mp4 !filter !diff !merge -text
*.MP4 !filter !diff !merge -text
GALLERY/** !filter !diff !merge -text

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Strong staff password for /backend.html
# (ADMIN_PASSWORD also works as an alias)
ADMIN_TOKEN=Rr6OrZTsbxJNfWcqFzyBQehb
HOST=127.0.0.1
PORT=8000

# Lead email notifications
# instant | digest_12h | both | off
LEAD_NOTIFY_MODE=both
LEAD_NOTIFY_EMAIL=contact@fitnessgurukul.co.in
LEAD_DIGEST_HOURS=12
# Optional separate cron token (defaults to ADMIN_TOKEN)
# CRON_TOKEN=
# Optional SMTP (Python cloud API). Hostinger PHP uses mail() without SMTP_*.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@fitnessgurukul.co.in

# Cloud deploy (Render / Railway / Fly.io):
# HOST=0.0.0.0
# PORT is set automatically by the platform
# Lock CORS to the live website domain:
CORS_ORIGINS=https://fitnessgurukul.co.in,https://www.fitnessgurukul.co.in,https://fitnessgurukul.in,https://www.fitnessgurukul.in
# Optional persistent SQLite folder on VPS/volume hosts:
# DATA_DIR=/var/data

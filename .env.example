# Vercel (project → Settings → Environment Variables):
# RESEND_API_KEY=re_xxx          # preferred reliable email
# LEAD_FROM_EMAIL=Fitness Gurukul <onboarding@resend.dev>
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx   # optional durable lead store for backend.html
# ADMIN_TOKEN=same-as-owner-portal
